# Opiinio — environment variables
#
# Copy this file to .env and fill in REAL values there.
# NEVER commit .env, and NEVER put a real secret in this file:
# every value below is a placeholder name only.
#
# Startup behaviour (src/lib/env.ts):
# - development (default) and staging: Supabase vars are optional;
#   the app boots in labelled preview mode and API routes return
#   generic 503 until configured. Nothing is faked as live.
# - production: SUPABASE_URL, SUPABASE_ANON_KEY, and APP_ORIGIN
#   are REQUIRED, and placeholder/example values are refused.
#   The app exits at boot with a generic message naming the
#   variable only (never the value).

# Public Supabase project URL, e.g. https://your-project.supabase.co
# (public identifier, not a secret — but still set it via env, never
# hard-coded in source). REQUIRED in production.
SUPABASE_URL=

# Public Supabase anon key (client-safe key, used by the browser).
# This is NOT the service-role key. Never put the service-role key
# in client code, in .env.example, or in git history.
# REQUIRED in production.
SUPABASE_ANON_KEY=

# Single allowed CORS origin for the API (Layer 5). Never "*".
# Defaults to http://localhost:3000 when unset.
# Set this to the deployed app origin (e.g. the Netlify URL) in
# staging and production. REQUIRED in production.
APP_ORIGIN=

# App environment: development | staging | production.
# Defaults to development. Controls startup validation strictness
# (see above) and is reported in /api/health as appEnv.
# Behaviour is identical across environments except the env name
# in health output — a deliberate decision (see
# docs/decisions/0016-hosting-observability.md).
APP_ENV=development

# Port the app listens on. Defaults to 3000 if unset.
PORT=3000

# NODE_ENV: development | production. Defaults to development.
# Kept for platform conventions (e.g. Netlify sets it); the app's
# own environment switch is APP_ENV above.
NODE_ENV=development
