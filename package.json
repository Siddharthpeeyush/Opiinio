{
  "description": "Opiinio — text-only opinion platform (real product scaffold, Part 0)",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.36.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "opiinio",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build",
    "dev": "npm run build && node --watch dist/src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests frontend/src",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "0.1.0"
}
